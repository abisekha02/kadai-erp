{
  "name": "kadai-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Storefront + admin ERP (inventory, orders, purchasing, invoices) built with Next.js and Postgres",
  "scripts": {
    "predev": "node scripts/photos.mjs",
    "dev": "next dev",
    "photos": "node scripts/photos.mjs",
    "build": "node scripts/photos.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "5.9.3",
    "next": "14.2.15",
    "pg": "8.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
  },
  "engines": { "node": ">=20" }
}
