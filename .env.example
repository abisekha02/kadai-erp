# Postgres connection string (Neon, Render, Supabase, local...). Tables are created automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string

# Optional: enables live product recommendations and admin insights in Kadai AI.
# Keep this key server-side only; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
